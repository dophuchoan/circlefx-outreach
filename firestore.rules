rules_version = '2';

// CircleFX Outreach — Firestore rules.
// Signed-in users only. Anyone with a Firebase Auth account created by the
// admin (Firebase console > Authentication > Users) can read and write the
// producers collection. Visitors who are not signed in get nothing.
// There is no admin-vs-user distinction here yet; that comes later via a
// custom claim. Do not add an admin email address to these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /producers/{docId} {
      allow read, write: if request.auth != null;
    }
    // Nothing else in this database is readable or writable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
